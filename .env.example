# =====================================================================================
#  Lisa — variáveis de ambiente
#  Copie para .env.local (desenvolvimento) e preencha. No deploy, cadastre as mesmas
#  variáveis no painel da Cloudflare (Workers → Settings → Variables) ou da Vercel.
#  NUNCA versione o .env.local: ele já está no .gitignore.
# =====================================================================================

# ---------------------------------------------------------------- OBRIGATÓRIAS

# Supabase (Settings → API). A service role ignora o RLS: só no servidor, nunca em NEXT_PUBLIC_*.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Settings → API → JWT Secret. É com ele que a Lisa confere a sessão de quem entrou.
SUPABASE_JWT_SECRET=

# Gemini (https://aistudio.google.com/apikey). Uma chave basta; com várias (de PROJETOS
# diferentes, separadas por vírgula) a Lisa reveza quando uma estoura a cota.
GEMINI_API_KEY=
# GEMINI_API_KEYS=chave-do-projeto-1,chave-do-projeto-2

# ---------------------------------------------------------------- ACESSO

# Vazio = todo mundo que entrar é admin e vê a Lisa COMPLETA (o normal numa instalação pessoal).
# Com e-mails/ids aqui (separados por vírgula), só eles são admin; os demais usam a versão
# limitada (MVP: conversa, voz, Modo Tela, editor de código e ProcessMap).
LISA_ADMINS=

# ---------------------------------------------------------------- SINCRONIZAÇÃO (cron)

# Segredos que protegem /api/ingest e /api/cron/*. Gere valores longos e aleatórios, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INGEST_SECRET=
CRON_SECRET=

# ---------------------------------------------------------------- PERSONALIZAÇÃO

# O quadro principal (o Kanban de "/" e o escopo padrão), com o nome exato do Abacato/Trello.
NEXT_PUBLIC_QUADRO_PRINCIPAL=Quarto de Guerra
# Apelidos de quadro: "apelido1,apelido2=Nome do quadro;..." (os mais específicos primeiro).
LISA_APELIDOS_DE_QUADRO=
# Quem mora com você, para o Modo Observância cumprimentar pelo nome: "Nome|descrição;..."
#   ex.: LISA_CASA=Ana|esposa do usuário;Pipoca|cachorra da família, vira-lata caramelo
LISA_CASA=
# Previsão do tempo (Modo Rádio e painel): "Cidade:latitude:longitude;..." (até 4).
LISA_CIDADES_DO_TEMPO=São Paulo:-23.5505:-46.6333
LISA_FUSO=America/Sao_Paulo

# ---------------------------------------------------------------- ABACATO (tarefas)

# Onde o Abacato está (links dos cards e leitura dos quadros). Em dev ele roda na porta 3001.
ABACATO_URL=http://localhost:3001
# O endereço que o menu "Lisa Task" abre (o mesmo Abacato, com o visual da Lisa).
LISA_TASK_URL=http://localhost:3001

# ---------------------------------------------------------------- CÉREBRO (notas)

# Opcional: o id (uuid) do usuário dono das notas na tabela `notes`. Vazio = todas as notas.
BRAIN_USER_ID=

# ---------------------------------------------------------------- TRELLO (opcional)

# Fonte alternativa de quadros (https://trello.com/power-ups/admin → API key e token).
TRELLO_KEY=
TRELLO_TOKEN=
# Ids dos quadros a indexar, separados por vírgula.
TRELLO_BOARD_IDS=
# O quadro com as aplicações do "Map of Deploy" (id ou código curto da URL do quadro).
TRELLO_DEPLOY_BOARD_ID=

# ---------------------------------------------------------------- GITHUB (opcional)

# Token de leitura para indexar repositórios e ler código na conversa (escopo de leitura).
GITHUB_TOKEN=
# GITHUB_ARQUIVOS_POR_VEZ=35

# ---------------------------------------------------------------- GROQ (opcional)

# Transcrição de fala (Whisper) e reserva de conversa (https://console.groq.com/keys).
GROQ_API_KEY=
# GROQ_API_KEYS=chave1,chave2
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODELO_DE_FALA=whisper-large-v3-turbo

# ---------------------------------------------------------------- AJUSTES DO GEMINI (opcional)

# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_CHAT_RESERVAS=gemini-3.5-flash,gemini-3.5-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIM=768
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_RESERVAS=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore
# GEMINI_RESERVA_INTERATIVA=8
# RAG_TOP_K=8
# RAG_MIN_SIMILARITY=0.55

# ---------------------------------------------------------------- SENTINELA (opcional)

# Integração com uma plataforma de chamados/testes num projeto Supabase SEPARADO.
# (Os nomes são esses mesmo, inclusive o "SUBABASE".)
SUBABASE_TESTE_URL=
SERVICE_KEY_TESTE=

# ---------------------------------------------------------------- NOTIFICAÇÕES PUSH (opcional)

# Chave pública VAPID (gere o par com: npx web-push generate-vapid-keys). A privada vai só no
# Worker de cron (workers/lisa-cron), como segredo.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------- LISA CODE / VS CODE (opcional)

# Token que a extensão do VS Code (vscode-extension/lisa-code) manda para falar com a Lisa.
LISA_EXTENSION_TOKEN=

# ---------------------------------------------------------------- SERVIDOR LOCAL (opcional)

# "1" libera a execução de comandos (lista fechada, ver src/lib/comandosPermitidos.js) — só numa
# Lisa rodando na SUA máquina, nunca na nuvem.
LISA_EXECUCAO_REMOTA=
# LISA_EXECUCAO_RAIZ=/caminho/da/pasta/de/projetos
# "1" quando a Lisa roda no servidor de casa (servidor/), com a tela remota em NEXT_PUBLIC_TELA_URL.
NEXT_PUBLIC_MODO_CASA=
NEXT_PUBLIC_TELA_URL=
