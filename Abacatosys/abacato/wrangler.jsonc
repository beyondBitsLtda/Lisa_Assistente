{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abacato",

  // Se a sua credencial enxerga mais de uma conta da Cloudflare, o wrangler se recusa a adivinhar
  // ("More than one account available"). Nesse caso, descomente e ponha o id da SUA conta (não é
  // segredo — é um endereço), ou rode com CLOUDFLARE_ACCOUNT_ID=... no ambiente.
  // "account_id": "SEU-ACCOUNT-ID",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  // nodejs_compat: o adaptador precisa dos modulos do Node.
  // global_fetch_strictly_public: sem isto, um fetch do Worker para o proprio dominio faz
  // laco dentro da Cloudflare em vez de sair para a internet.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": true,
  // Sem isto, todo `wrangler deploy` APAGA as variaveis configuradas no painel. Ja custou uma
  // manha na Lisa: o deploy passava, e as chaves sumiam sem nenhum erro.
  "keep_vars": true,
  "observability": { "enabled": true },
  // Domínios próprios (opcional). Dois endereços, o mesmo Abacato: o lisatask é o que o menu
  // Lisa Task da Lisa abre (o visual da Lisa sai do endereço e do tipo da conta; ver
  // src/middleware.js e NEXT_PUBLIC_LISA_TASK_HOST). Descomente e troque pelos seus:
  // "routes": [
  //   { "pattern": "abacato.seudominio.com", "custom_domain": true },
  //   { "pattern": "lisatask.seudominio.com", "custom_domain": true }
  // ]
}
