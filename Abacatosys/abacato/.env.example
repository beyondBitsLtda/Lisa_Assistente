# =====================================================================================
#  Abacato — variáveis de ambiente
#  Copie para .env.local (desenvolvimento) e preencha. No Cloudflare Worker, os três
#  primeiros vão como segredos (wrangler secret put ...). NUNCA versione o .env.local.
# =====================================================================================

# O mesmo Supabase da Lisa (Settings → API). A service role ignora o RLS: só no servidor.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Qualquer texto longo e aleatório; trocar derruba todas as sessões abertas.
ABACATO_SESSAO_SECRET=

# A Lisa dentro do Abacato (a assistente dos quadros). Mesmas chaves do Gemini da Lisa.
GEMINI_API_KEY=
# GEMINI_API_KEYS=chave-do-projeto-1,chave-do-projeto-2
# GEMINI_CHAT_MODEL=gemini-3.6-flash

# Os endereços (entram no build — não são segredo).
NEXT_PUBLIC_LISA_URL=http://localhost:3000
NEXT_PUBLIC_ABACATO_HOST=localhost:3001
# Opcional: um segundo endereço para o mesmo Abacato com o visual da Lisa (o menu "Lisa Task").
NEXT_PUBLIC_LISA_TASK_HOST=
# As origens que podem mandar alguém entrar pela Lisa (separadas por vírgula). Vazio = NEXT_PUBLIC_LISA_URL.
LISA_ORIGEM=
